# Configuration optionnelle du serveur
PORT=3000

# Cache/rate-limiting partagé entre plusieurs instances (déploiement multi-serveurs).
# Optionnel : sans cette variable, chaque instance garde son propre cache/compteurs en mémoire.
# REDIS_URL=redis://localhost:6379

# Recherche de Cours & Notions : "true" désactive le dernier recours externe
# (Wikipédia/Wikidata) et force un mode 100% local/déterministe, au prix d'un
# "aucun résultat" pour les rares requêtes hors-programme non couvertes en local.
# DISABLE_EXTERNAL_KNOWLEDGE_FALLBACK=true

# Limites de débit globales (tous utilisateurs confondus), ajustables selon l'infrastructure :
# GLOBAL_SEARCH_MAX_REQUESTS_PER_MIN=20000
# GLOBAL_SUGGEST_MAX_REQUESTS_PER_MIN=40000


# Mode IA : aucun fournisseur d'IA générative n'est configuré dans Le Prof.
# Le dictionnaire et les moteurs scolaires utilisent des traitements locaux et des données lexicales/documentaires.
