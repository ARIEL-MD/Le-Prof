{
  "name": "le-prof",
  "private": true,
  "version": "0.0.0-v10",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server-cluster.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test server/__tests__/*.test.ts",
    "test:orchestrator": "node --import tsx --test server/__tests__/*.test.ts",
    "bench:search": "node --import tsx scripts/bench-course-search.ts",
    "load:search": "node --import tsx scripts/load-test-search-course.ts",
    "test:math": "node --import tsx --test server/__tests__/mathGeneralistRobustness.test.ts server/__tests__/mathUniversalCoverage.test.ts server/__tests__/mathReferenceAndAdvanced.test.ts server/__tests__/mathUniversalUpgrade.test.ts",
    "audit:course-search": "node --import tsx scripts/audit-course-search.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.7.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "katex": "^0.18.5",
    "lucide-react": "^0.546.0",
    "mathjs": "^15.2.0",
    "mathlive": "^0.110.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.1"
  }
}
